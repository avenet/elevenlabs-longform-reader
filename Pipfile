[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
fastapi = "*"
uvicorn = {extras = ["standard"], version = "*"}
python-multipart = "*"
sqlalchemy = "*"
pydantic-settings = "*"
elevenlabs = "*"
pypdf = "*"
aiofiles = "*"

[dev-packages]
pytest = "*"
pytest-asyncio = "*"
ruff = "*"
httpx = "*"
pre-commit = "*"
pytest-cov = "*"

[scripts]
lint = "ruff check ."
fmt = "ruff format ."
lint-fixup = "ruff check --fix ."
test = "pytest"
test-unit = "pytest -m 'not integration'"
test-live = "pytest -m integration"
serve = "uvicorn app.main:app --reload"
check = "bash -c 'ruff check . && pytest -m \"not integration\"'"
cov = "pytest -m 'not integration' --cov=app --cov-report=term-missing"

[requires]
python_version = "3.14"
